<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="405.0" prefWidth="291.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/23.0.1" fx:controller="com.example.kursach.ChangeProductController">
    <children>
        <Label layoutX="44.0" layoutY="6.0" text="Выберите продукт для изменения:" />
        <ListView fx:id="productListView" layoutX="21.0" layoutY="41.0" onMouseClicked="#handleProductSelection" prefHeight="150" prefWidth="250" />
        <Label layoutX="20" layoutY="200" text="Имя:" />
        <TextField fx:id="nameField" layoutX="20" layoutY="220" />
        <Label layoutX="20" layoutY="260" text="Описание:" />
        <TextField fx:id="descriptionField" layoutX="20" layoutY="280" />
        <Label layoutX="20" layoutY="320" text="Путь к изображению:" />
        <TextField fx:id="imagePathField" layoutX="20" layoutY="340" />
        <Button layoutX="20" layoutY="380" onAction="#handleChangeProduct" text="Изменить" />
        <Button layoutX="100" layoutY="380" onAction="#handleCancel" text="Отмена" />
    </children>
</AnchorPane>
